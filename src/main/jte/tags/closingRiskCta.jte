@param String sourceContext
@param String heading = "A deadline turns a records search into a closing decision."

<aside class="closing-risk-cta" data-closing-risk-cta-container>
    <div>
        <span class="eyebrow">Free human review · beta</span>
        <h2>${heading}</h2>
        <p>Send the property, deadline, and current file status. Get a focused reply showing what is confirmed, missing, or conflicting before due diligence ends.</p>
    </div>
    <div class="closing-risk-cta__action">
        <a class="button button--primary"
           href="/offer-prep-septic-file-check/#free-closing-risk-check"
           data-closing-risk-cta
           data-track-click="nav"
           data-track-source-context="${sourceContext}"
           data-track-target-type="lead_form">Request a free manual review</a>
        <small>First 10 qualified requests. No payment details.</small>
    </div>
</aside>
