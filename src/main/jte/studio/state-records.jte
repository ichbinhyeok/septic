@import com.example.septic.web.PageMeta
@import com.example.septic.data.model.StateMoneyPage
@import com.example.septic.data.model.StateProfile
@import com.example.septic.data.model.SourceRecord
@import com.example.septic.web.PageLink
@import com.example.septic.web.AssetPaths
@param StateMoneyPage stateMoneyPage
@param StateProfile state
@param java.util.List<SourceRecord> sources
@param java.util.List<SourceRecord> localAuthoritySources
@param java.util.List<SourceRecord> recordsLookupSources
@param java.util.List<PageLink> countyRecordLinks
@param java.util.List<PageLink> featuredCountyRecordLinks
@param java.util.List<PageLink> internalLinks
@param java.util.List<com.example.septic.web.CountyWorkflowFieldView> stateOfficialFilePathRows
@param com.example.septic.web.StateCountyWorkflowSynthesisView countyWorkflowSynthesis = null
@param com.example.septic.web.StateWorkflowDecisionView workflowDecision = null
@param com.example.septic.web.StateRecordsSearchResponseView stateRecordsSearchResponse = null
@param com.example.septic.web.StudioCaseStudies.Study featuredStudy
@param String calculatorPath
@param String editorialLastReviewedAt
@param String recordsHeroImage
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = stateMoneyPage.title(), heroImage = recordsHeroImage, mobileHeroImage = "/images/studio/guides-mobile-v1.webp", pageClass = "studio-state-records", pageStyles = "/studio-state-records.css", content = @`
<main id="main">
<section class="sr-hero" aria-labelledby="sr-title"><picture><source media="(max-width:700px)" srcset="/images/studio/guides-mobile-v1.webp"><img src="${recordsHeroImage}" alt="" width="1672" height="941" fetchpriority="high"></picture><div class="sr-hero__veil"></div><div class="studio-wrap sr-hero__inner"><p class="studio-overline">${state.stateName()} / Property records</p><h1 id="sr-title">Find the file.<br>Read what it proves.</h1><p>${stateMoneyPage.introCopy()}</p><div class="sr-hero__actions"><a class="studio-button" href="#county-routes">Find the local route <span aria-hidden="true">↓</span></a><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">Have a file? Ask for review ↗</a></div><small>Independent research · Official-source context · Reviewed ${editorialLastReviewedAt}</small></div></section>

<section class="sr-opening studio-wrap"><div><p class="studio-overline">The ${state.stateName()} path</p><h2>The address is a clue.<br>The custodian is the route.</h2></div><div><p class="sr-lede">${stateMoneyPage.uniqueAngle()}</p>@if(stateRecordsSearchResponse != null)<p>${stateRecordsSearchResponse.summary()}</p>@endif<a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/", production)}">See how we investigate real properties <span aria-hidden="true">↗</span></a></div></section>

<section class="sr-route" id="official-route"><figure><img src="/images/studio/official-lookup-map-v1.webp" alt="Illustrative county research map and property index" width="1456" height="1080" loading="lazy"><figcaption>Illustrative research material—not a ${state.stateName()} property record.</figcaption></figure><div class="sr-route__copy"><p class="studio-overline">Start in the right office</p><h2>${state.stateName()},<br>at a glance.</h2><dl>@for(var row : stateOfficialFilePathRows)<div><dt>${row.label()}</dt><dd>${row.value()}</dd></div>@endfor</dl>@if(workflowDecision != null)<details><summary>${workflowDecision.heading()} <span aria-hidden="true">+</span></summary><p>${workflowDecision.intro()}</p><dl>@for(var row : workflowDecision.cards())<div><dt>${row.label()}</dt><dd>${row.value()}</dd></div>@endfor</dl></details>@endif</div></section>

<section class="sr-counties" id="county-routes" aria-labelledby="sr-counties-title"><div class="studio-wrap"><div class="sr-counties__heading"><div><p class="studio-overline">Published local workflows</p><h2 id="sr-counties-title">Go straight to<br>the county route.</h2></div><p>A county guide explains the working portal, form, email, call, or public-records request—and what to try when the first search is empty.</p></div>@if(!countyRecordLinks.isEmpty())<label class="sr-county-search">Filter ${countyRecordLinks.size()} routes<input type="search" placeholder="Type a county name" data-studio-county-search aria-controls="sr-county-list"></label><ul id="sr-county-list">@for(var link : countyRecordLinks)<li data-studio-county="${link.compactTitle()}"><a href="${link.path()}"><span>${link.compactTitle()}</span><small>Open the verified local workflow</small><b aria-hidden="true">↗</b></a></li>@endfor</ul>@if(countyRecordLinks.size() > 8)<button class="sr-counties__toggle" type="button" data-studio-county-toggle aria-expanded="false">Show every ${state.stateName()} county route <span aria-hidden="true">↓</span></button>@endif<p class="sr-counties__status" data-studio-county-status aria-live="polite">Showing ${Math.min(8, countyRecordLinks.size())} of ${countyRecordLinks.size()} published county routes. Search checks the full list.</p>@else<div class="sr-counties__empty"><p>No county-specific guide is published here yet. The statewide sources and request checklist below still provide a careful starting point.</p><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/#find-route", production)}">Start with the property address <span aria-hidden="true">↗</span></a></div>@endif</div></section>

<section class="sr-file"><div><p class="studio-overline">Request the useful artifact</p><h2>Do not stop at<br>“a record was found.”</h2><p>The answer is usually inside the permit packet, drawing, approval, inspection, or repair history.</p><ul>@if(state.recordsToRequest() != null)@for(var item : state.recordsToRequest())<li>${item}</li>@endfor@endif</ul></div><figure><img src="/images/studio/file-dividers-v1.webp" alt="Illustrative permit history, site plan, repair record and agency correspondence dividers" width="1792" height="960" loading="lazy"><figcaption>Illustrative file categories with no property identity.</figcaption></figure></section>

@template.studio.research-proof(production = production, study = featuredStudy, directCase = true, imageOverride = "/images/studio/checklist-case-house-v1.webp", imageNote = "Illustrative setting", imageWidth = 1561, imageHeight = 1008)

<section class="sr-method studio-wrap"><div class="sr-method__heading"><p class="studio-overline">What we look for</p><h2>Turn a search result<br>into a usable finding.</h2></div><ol>@for(int i=0;i<stateMoneyPage.decisionSteps().size();i++)<li><span>0${i+1}</span><p>${stateMoneyPage.decisionSteps().get(i)}</p></li>@endfor</ol><div class="sr-method__depth"><div><h3>${stateMoneyPage.riskHeading(state.stateName())}</h3><ul>@for(var item : stateMoneyPage.lowEndBreakers())<li>${item}</li>@endfor</ul></div><div><h3>What changes the route</h3><ul>@for(var item : stateMoneyPage.driverBullets())<li>${item}</li>@endfor</ul></div></div></section>

@if(countyWorkflowSynthesis != null)<section class="sr-patterns"><div class="studio-wrap"><p class="studio-overline">Research depth</p><h2>${countyWorkflowSynthesis.heading()}</h2><p class="sr-patterns__intro">${countyWorkflowSynthesis.intro()}</p><div class="sr-patterns__facts">@for(var row : countyWorkflowSynthesis.structureHighlights())<div><span>${row.label()}</span><strong>${row.value()}</strong></div>@endfor</div>@for(var signal : countyWorkflowSynthesis.signals())<details><summary>${signal.label()} <span aria-hidden="true">+</span></summary><p>${signal.summary()}</p><p>${signal.countyExamples()}</p><p>${signal.coverageNote()}</p><p><strong>First ask:</strong> ${signal.firstAsk()}</p></details>@endfor<div class="sr-patterns__lists"><div><h3>${countyWorkflowSynthesis.firstArtifactsHeading()}</h3><ul>@for(var item : countyWorkflowSynthesis.firstArtifacts())<li>${item}</li>@endfor</ul></div><div><h3>${countyWorkflowSynthesis.countyDropHeading()}</h3><ul>@for(var item : countyWorkflowSynthesis.countyDropTriggers())<li>${item}</li>@endfor</ul></div><div><h3>${countyWorkflowSynthesis.holdQuoteHeading()}</h3><ul>@for(var item : countyWorkflowSynthesis.holdQuoteChecks())<li>${item}</li>@endfor</ul></div></div></div></section>@endif

<section class="sr-prep studio-wrap"><div><p class="studio-overline">For the next request</p><h2>${stateMoneyPage.quoteChecklistHeading()}</h2><p>${stateMoneyPage.targetReader()}</p></div><div><ol>@for(var item : stateMoneyPage.quotePrepChecklist())<li>${item}</li>@endfor</ol><details><summary>Who this guide fits <span aria-hidden="true">+</span></summary><ul>@for(var item : stateMoneyPage.fitBullets())<li>${item}</li>@endfor</ul></details><div class="sr-prep__actions"><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath <span aria-hidden="true">↗</span></a><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.preview(calculatorPath)}">Open the planning estimator <span aria-hidden="true">↗</span></a></div></div></section>

<section class="sr-sources studio-wrap"><div><p class="studio-overline">Traceable guidance</p><h2>Official sources<br>and next routes.</h2></div><div><ul class="studio-sources">@for(var source : sources)<li><a href="${source.url()}" target="_blank" rel="noopener noreferrer">${source.title()} ↗</a><span>${source.agencyName()} · reviewed ${source.contentVerifiedAt()}</span></li>@endfor</ul>@if(!internalLinks.isEmpty())<details class="sr-related-disclosure"><summary>Continue the research <span aria-hidden="true">+</span></summary><ul class="sr-related">@for(var link : internalLinks)<li><a href="${com.example.septic.web.StudioGuideRoutes.preview(link.path())}">${link.title()} <span aria-hidden="true">↗</span></a></li>@endfor</ul></details>@endif</div></section>

<section class="sr-faq studio-wrap"><p class="studio-overline">Before the next decision</p><h2>Common questions.</h2>@for(var faq : stateMoneyPage.faqBlocks())<details><summary>${faq.question()} <span aria-hidden="true">+</span></summary><p>${faq.answer()}</p></details>@endfor</section>

<section class="sr-closing"><img src="/images/studio/checklist-closing-house-v1.webp" alt="" width="1774" height="887" loading="lazy"><div class="studio-wrap"><p class="studio-overline">One property. One unanswered question.</p><h2>A missing record<br>should not be a dead end.</h2><p>Bring the address, the search history, and the decision ahead.</p><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Investigate my property <span aria-hidden="true">↗</span></a></div></section>
</main><script src="${AssetPaths.versioned("/studio.js")}" defer></script>
`)
