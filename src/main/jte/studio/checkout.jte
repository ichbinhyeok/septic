@import com.example.septic.web.PageMeta
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = "Private result preview", heroImage = "/images/studio/work-desk-v1.webp", pageClass = "studio-transaction studio-checkout", pageStyles = "/studio-transaction.css", content = @`
<main id="main">
<section class="stx-hero stx-hero--checkout"><img src="/images/studio/work-desk-v1.webp" alt="" width="1536" height="1024" fetchpriority="high"><div class="stx-shade"></div><div class="studio-wrap stx-hero__inner"><p class="studio-overline">Private result preview</p><h1>Your reviewed property record is ready.</h1><p>Matched to the property. Read against your question. Ready to deliver.</p><small>Official-source records · Human review · Clear limits</small></div></section>
<section class="stx-evidence"><div class="studio-wrap stx-evidence__grid"><header><p class="studio-overline">Before you unlock</p><h2>What the record can answer.</h2></header><dl><div><dt>Official source</dt><dd>County environmental health record file</dd></div><div><dt>Document scope</dt><dd>Permit, site drawing and completion record</dd></div><div><dt>Your question</dt><dd>What does the file show about the approved system and its location?</dd></div><div><dt>Important limits</dt><dd>The file documents the historical approval. It does not verify today’s field condition or exact underground position.</dd></div></dl></div></section>
<section class="stx-purchase"><div class="studio-wrap stx-purchase__grid"><div><p class="studio-overline">The reviewed package</p><h2>A complete, human review of the records that matter.</h2><p>Research and agency requests were free. This optional purchase is for the useful, property-matched records and reviewed answers described above.</p></div><ul><li>Original source records</li><li>Property-specific findings</li><li>Plain-English limits and next steps</li><li>A private, time-limited delivery link</li></ul><div class="stx-checkout"><p class="stx-price">One-time · US $29</p><button class="studio-button" type="button" data-demo-checkout>Unlock the reviewed package <span aria-hidden="true">→</span></button><p data-demo-status aria-live="polite"></p><small>Secure provider-hosted checkout. No automatic charge.<br>Never send card details by email.</small></div></div></section>
</main><script src="/studio-transaction.js" defer></script>
`)
