@import com.example.septic.web.PageMeta
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = "Property record research", heroImage = "/images/studio/research-room-v1.webp", pageClass = "studio-service", pageStyles = "/studio-editorial.css", mobileHeroImage = "/images/studio/mobile-research-v1.webp", content = @`
<main id="main">
    <section class="studio-hero editorial-hero" aria-labelledby="service-title">
        <picture class="editorial-hero__picture"><source media="(max-width: 700px)" srcset="/images/studio/mobile-research-v1.webp"><img class="studio-hero__image" src="/images/studio/research-room-v1.webp" alt="" width="1672" height="941" fetchpriority="high"></picture><div class="studio-hero__shade"></div>
        <div class="studio-wrap studio-hero__inner"><div class="studio-hero__copy"><p class="studio-overline">Property answers start here</p><h1 id="service-title"><span>You bring<br>the address.</span><span>We find the<br>paper trail.</span></h1><p class="studio-hero__intro">Septic records, official routes,<br>and a clearer next step.</p><a class="studio-button" href="#start">Start the research <span aria-hidden="true">↗</span></a><a class="studio-text-link" href="#pricing">Free research. Optional US $29 result unlock.</a></div></div>
    </section>
    <section class="editorial-intro studio-wrap" aria-labelledby="service-intro"><div><p class="studio-overline">A clearer way forward</p><h2 id="service-intro">Less chasing records.<br>More understanding.</h2></div><div><p>From the property clues to the responsible office, we follow the record trail so you don't have to.</p><p>We explain what the evidence supports—and what it cannot establish.</p></div></section>
    <figure class="editorial-panorama"><img src="/images/studio/file-dividers-v1.webp" alt="Illustrative file dividers for permit history, site plans, repair records, and agency correspondence" width="1672" height="941" loading="lazy"></figure>
    <section class="studio-process service-process" id="how-it-works" aria-labelledby="process-title"><div class="studio-wrap"><p class="studio-overline">A simple path forward</p><h2 id="process-title" class="editorial-sr-only">How the research works</h2><ol class="studio-steps">
        <li><span class="studio-steps__number" aria-hidden="true">01</span><div><h3>We trace the source.</h3><p>We identify the record owner, search available sources, and request missing records when needed.</p></div><a href="#start">Start with the address <span aria-hidden="true">→</span></a></li>
        <li><span class="studio-steps__number" aria-hidden="true">02</span><div><h3>You preview the findings.</h3><p>See the source, property-match status, useful questions the file can answer, and important gaps.</p></div><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/", production)}">See our work <span aria-hidden="true">→</span></a></li>
        <li><span class="studio-steps__number" aria-hidden="true">03</span><div><h3>You choose the next step.</h3><p>Choose whether to unlock the original records and property-specific explanation. No automatic charge.</p></div><a href="#pricing">Understand the cost <span aria-hidden="true">→</span></a></li>
    </ol></div></section>
    <section class="editorial-pricing studio-wrap" id="pricing" aria-labelledby="pricing-title"><div><p class="studio-overline">Simple, transparent pricing</p><h2 id="pricing-title">Clear costs.<br>No surprises.</h2><p>Start with research. Decide after seeing what we found.</p></div><div><dl class="price-ledger"><div><dt>Research &amp; agency requests<span>We investigate the property and request records.</span></dt><dd>Free</dd></div><div><dt>Useful result package<span>Original records and a property-specific explanation.</span></dt><dd>Optional US $29</dd></div><div><dt>Agency fees<span>Any agency charge requires your approval.</span></dt><dd>At cost, with approval</dd></div></dl><p class="studio-fine">No upfront payment or automatic charge. We only offer the unlock when useful, property-matched evidence can answer your question.</p></div></section>
    <section class="studio-closing editorial-start" id="start" aria-labelledby="start-title"><img src="/images/studio/oak-pasture-v1.webp" alt="" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">Start where you are</p><h2 id="start-title">What do you have today?</h2><p>Send one property and the question you need answered.</p><div class="editorial-choices"><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">I have an address <span aria-hidden="true">↗</span></a><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">I already have a file <span aria-hidden="true">↗</span></a></div><p class="editorial-start__note">No upfront payment. No automatic charge.</p></div></section>
    <section class="editorial-faq studio-wrap" aria-labelledby="faq-title"><p class="studio-overline">Before you begin</p><h2 id="faq-title">A few things worth knowing.</h2>
        <details><summary>What if you cannot find a useful record? <span aria-hidden="true">+</span></summary><p>We explain the search limits and what remains unanswered. We do not offer the $29 unlock unless useful, property-matched evidence can answer your question. An empty portal search alone is not an official no-record response.</p></details>
        <details><summary>Is this a septic inspection or an approval? <span aria-hidden="true">+</span></summary><p>No. Historical records describe documented designs, approvals, and other recorded activity. They do not establish current condition, exact field locations, or approval for a new project. Those may require field work or agency confirmation.</p></details>
        <details><summary>What happens to the information I submit? <span aria-hidden="true">+</span></summary><p>The existing request form privately stores the address and attached records and emails them to the SepticPath operator for a human reply. Do not submit Social Security numbers, payment details, access codes, or unrelated personal documents. <a href="${com.example.septic.web.StudioGuideRoutes.route("/privacy-policy/", production)}">Read the privacy policy.</a></p></details>
        <details><summary>Can I search or prepare a request myself? <span aria-hidden="true">+</span></summary><p>Yes. Use the <a href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/#find-route", production)}">record finder</a> or <a href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/#draft-request", production)}">request builder</a> to explore the official route yourself.</p></details>
    </section>
</main>
`)
