@import com.example.septic.web.PageMeta
@import com.example.septic.web.StudioCaseStudies.Study
@import com.example.septic.web.StudioGuideRoutes
@param Study study
@param java.util.List<Study> related
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = study.title(), heroImage = "/images/studio/" + study.hero(), mobileHeroImage = "/images/studio/" + study.mobile(), pageClass = "studio-work", pageStyles = "/studio-case.css", content = @`
<main id="main" class="case-editorial">
<section class="case-hero"><picture><source media="(max-width:700px)" srcset="/images/studio/${study.mobile()}"><img src="/images/studio/${study.hero()}" alt="" width="1672" height="941" fetchpriority="high"></picture><div class="studio-wrap"><p class="studio-overline">Our work / ${study.place()}</p><h1>${study.title()}</h1><p>${study.question()}</p><a class="studio-button" href="#case-angle">Inside the investigation <span aria-hidden="true">↓</span></a><a class="case-hero-inquiry" href="#case-next-title">Have a similar question? <span aria-hidden="true">↓</span></a></div></section>
<nav class="case-breadcrumb studio-wrap" aria-label="Breadcrumb"><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/", production)}">Our work</a><span aria-hidden="true">/</span><span>${study.place()}</span></nav>
<section class="case-story studio-wrap" aria-labelledby="case-angle"><aside><p class="studio-overline">Our research angle</p><h2 id="case-angle">${study.angle()}</h2>@if(!study.original().isEmpty())<a class="studio-text-link" href="${StudioGuideRoutes.preview(study.original())}">Read the original case account ↗</a>@else<p class="case-source-note">Identifying details omitted. Source documents and correspondence are retained privately.</p>@endif</aside><ol>@for(int i=0;i<2;i++)<li><span aria-hidden="true">0${i+1}</span><div><h3>${study.stepTitle(i)}</h3><p>${study.story().get(i)}</p></div></li>@endfor</ol></section>
<section class="case-interlude"><img src="/images/studio/${study.interludeImage()}" alt="" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">The decision behind the finding</p><h2>${study.bridge()}</h2></div></section>
<section class="case-evidence studio-wrap" id="case-evidence"><div class="case-evidence-heading"><p class="studio-overline">What the records show</p><h2>${study.heading()}</h2></div>
@if(!study.image().isEmpty())<figure class="case-source"><a href="${study.image()}" target="_blank" rel="noopener noreferrer" aria-label="Open public source excerpt at full size"><img src="${study.image()}" alt="${study.caption()}" loading="lazy"></a><figcaption>${study.caption()} <a href="${study.image()}" target="_blank" rel="noopener noreferrer">Open full size ↗</a></figcaption></figure>@endif
<dl class="case-facts">@for(int i=0;i<study.facts().size();i++)<div class="${i < 2 ? "case-fact-lead" : ""}"><dt>${study.facts().get(i).source()}</dt><dd>${study.facts().get(i).value()}</dd></div>@endfor</dl>
@if(study.image().isEmpty())<p class="case-source-note">${study.caption()}</p>@endif
</section>
<section class="case-outcome"><div class="studio-wrap"><div class="case-delivery"><p class="studio-overline">What the customer received</p><h2>The answer.<br>And its boundaries.</h2><p>${study.story().get(2)}</p></div><div class="case-limit"><p class="studio-overline">What remains open</p><h3>What this does not establish.</h3><p>${study.limit()}</p></div></div></section>
<section class="case-next studio-wrap" aria-labelledby="case-next-title"><div><p class="studio-overline">Now, your property</p><h2 id="case-next-title">What could we uncover<br>at your address?</h2><p>Tell us what you need to decide. We’ll include this case as context, then investigate your property on its own evidence.</p></div><div><a class="studio-button" href="/offer-prep-septic-file-check/?from=case&amp;caseStudy=${study.slug()}#intake-form">Investigate my address <span aria-hidden="true">↗</span></a><p class="studio-fine">Free research. No upfront payment.<br>Record availability and outcomes vary by property.</p></div></section>
<section class="case-related studio-wrap"><p class="studio-overline">More real investigations</p><h2>Different questions. The same care.</h2><div>@for(var item : related)@if(!item.slug().equals(study.slug()))<a href="/septic-record-brief-example/${item.slug()}/"><span>${item.place()}</span>${item.title()} <b aria-hidden="true">↗</b></a>@endif@endfor<a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/#sale-case", production)}"><span>Shelby County, Tennessee</span>A missing file for a buyer. <b aria-hidden="true">↗</b></a></div></section>
</main>
`)
