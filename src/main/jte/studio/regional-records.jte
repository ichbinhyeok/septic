@import com.example.septic.web.PageMeta
@import com.example.septic.data.model.CountyRecordsPage
@import com.example.septic.web.FloridaCountyRouteView
@import com.example.septic.web.SouthCarolinaCountyRouteView
@import com.example.septic.web.AssetPaths
@param String regionCode
@param java.util.List<CountyRecordsPage> texasCountyRoutes = java.util.List.of()
@param java.util.List<FloridaCountyRouteView> floridaCountyRoutes = java.util.List.of()
@param java.util.List<SouthCarolinaCountyRouteView> southCarolinaCountyRoutes = java.util.List.of()
@param com.example.septic.web.StudioCaseStudies.Study featuredStudy
@param PageMeta page = null
@param boolean production = false
!{var texas = "TX".equals(regionCode);}
!{var southCarolina = "SC".equals(regionCode);}
!{var regionName = texas ? "Texas" : southCarolina ? "South Carolina" : "Florida";}
!{var programName = texas ? "OSSF" : southCarolina ? "SCDES" : "OSTDS";}
!{var heroImage = texas ? "/images/studio/oak-pasture-v1.webp" : southCarolina ? "/images/studio/property-hero-v1.webp" : "/images/studio/county-property-v1.webp";}
@template.studio.shell(page = page, production = production, title = regionName + " septic record route", heroImage = heroImage, pageClass = "studio-regional studio-regional--" + regionCode.toLowerCase(), pageStyles = "/studio-regional-records.css", content = @`
<main id="main" data-regional-records data-region-code="${regionCode}" data-region-name="${regionName}" data-program-name="${programName}">
    <section class="regional-hero" aria-labelledby="regional-title"><img src="${heroImage}" alt="Rural property landscape used to introduce the ${regionName} records route" width="1672" height="941" fetchpriority="high"><div class="regional-hero__wash"></div><div class="studio-wrap"><p class="studio-overline">${regionName} / ${programName} records</p><h1 id="regional-title">${texas ? "Find who permitted the system." : southCarolina ? "Bring the right identifier." : "Route the county before the search."}</h1><p>${texas ? "Texas has no single property-record database. Identify the authorized local agent, then carry the property clues into that file route." : southCarolina ? "A TMS or permit number can unlock the public search. An address alone usually needs a county identifier or a written request." : "Current permits and historical files can sit with different offices. Start with the county, then keep both paths visible."}</p><a class="studio-button" href="#route-workspace">Prepare the record route <span aria-hidden="true">↘</span></a></div></section>
    <section class="regional-principle studio-wrap" aria-labelledby="principle-title"><p class="studio-overline">The route in one sentence</p><h2 id="principle-title">${texas ? "Authority first. Property file second." : southCarolina ? "Identifier first. Site Explorer second." : "Current authority and historical archive are not always the same desk."}</h2><p>${texas ? "TCEQ’s authority search identifies the regulator; it is not the parcel permit." : southCarolina ? "A map result is not proof that the permit file was found." : "In transitioned counties, DEP may handle new permits while county health still holds older records."}</p></section>
    <section class="regional-workspace" id="route-workspace" aria-labelledby="route-title"><div class="studio-wrap"><div class="regional-workspace__heading"><div><p class="studio-overline">01 / Prepare the official route</p><h2 id="route-title">Give the office more than one way to find the file.</h2></div><p>Your entries stay in this browser. Nothing is sent to an agency or to SepticPath.</p></div><form data-regional-form><div class="regional-fields"><label><span>County</span><select required data-regional-county><option value="">Choose a county</option>
        @if(texas)@for(var county : texasCountyRoutes)<option value="${county.countySlug()}" data-county-name="${county.countyName()}" data-guide-path="${county.path("texas")}" data-official-url="${county.recordsUrl()}" data-office-label="${county.recordsLabel()}">${county.countyName()}</option>@endfor
        @elseif(southCarolina)@for(var county : southCarolinaCountyRoutes)<option value="${county.countyKey()}" data-county-name="${county.countyName()}" data-guide-path="${county.internalPath()}" data-official-url="https://epermitting.des.sc.gov/ext/nsite/default/map/help" data-office-label="SCDES Site Explorer or Onsite Wastewater">${county.countyName()}</option>@endfor
        @else @for(var county : floridaCountyRoutes)<option value="${county.countyKey()}" data-county-name="${county.countyName()}" data-guide-path="/septic-records/florida/${county.countyKey()}-county/" data-official-url="${county.recordsUrl()}" data-office-label="${county.recordsLabel()}" data-route-owner="${county.depManaged() ? "Florida DEP + county archive" : "County Environmental Public Health"}">${county.countyName()}</option>@endfor @endif
        </select></label><label><span>Search by</span><select data-regional-clue-type><option value="address">Street address</option><option value="parcel">${southCarolina ? "TMS / tax map number" : "Parcel or property ID"}</option><option value="owner">Current or prior owner</option><option value="permit">Permit number</option></select></label><label class="regional-fields__wide"><span data-regional-clue-label>Street address</span><input required maxlength="160" autocomplete="street-address" placeholder="123 Main Street" data-regional-clue></label><label><span>Secondary identifier <small>optional</small></span><input maxlength="120" placeholder="Parcel, owner, subdivision or lot" data-regional-secondary></label><label><span>Approximate install year <small>optional</small></span><input maxlength="20" inputmode="numeric" placeholder="e.g. 1998" data-regional-year></label></div><button class="studio-button" type="submit">Build the route <span aria-hidden="true">↗</span></button><p class="regional-error" role="alert" data-regional-error hidden></p></form>
        <section class="regional-result" data-regional-result hidden aria-live="polite"><div class="regional-result__summary"><p class="studio-overline">Route prepared</p><h2 tabindex="-1" data-regional-result-title></h2><p data-regional-result-copy></p></div><div class="regional-result__steps"><article><span>01</span><h3>Carry the match keys</h3><ul data-regional-keys></ul><button type="button" data-regional-copy>Copy search clues</button></article><article><span>02</span><h3>Open the file owner</h3><p data-regional-office></p><div><a class="studio-button" target="_blank" rel="noreferrer" data-regional-official>Open official route ↗</a><a data-regional-guide>Read county instructions →</a></div></article><article><span>03</span><h3>Ask for the complete file</h3><ul><li>Application and permit</li><li>Site evaluation and approved layout</li><li>Final approval or operation record</li><li>Repair, alteration and complaint history</li></ul><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-records-request-builder/?mode=task", production)}" data-regional-request>Build the written request →</a></article></div></section></div></section>
    <section class="regional-documents"><img src="/images/studio/official-lookup-files-v1.webp" alt="Permit application, site sketch, final approval and repair history arranged together" width="1456" height="1024" loading="lazy"><div><p class="studio-overline">The permit is only one page of the story</p><h2>Ask for the file around the permit.</h2><p>A useful record trail can include the application, approved site plan, final inspection, repair history and a written no-record response when nothing is located.</p><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/", production)}">See how we investigate incomplete files ↗</a></div></section>
    <section class="regional-proof studio-wrap"><div><p class="studio-overline">A real investigation</p><h2>${featuredStudy.question()}</h2><p>${featuredStudy.intro()}</p><a class="studio-button" href="/septic-record-brief-example/${featuredStudy.slug()}/">Read the case study <span aria-hidden="true">↗</span></a></div><dl><div><dt>Place</dt><dd>${featuredStudy.place()}</dd></div><div><dt>Findings</dt><dd>${featuredStudy.facts().size()} source-tied facts preserved</dd></div><div><dt>Boundary</dt><dd>Representative research—not proof that a record exists for this property.</dd></div></dl></section>
    <section class="regional-final"><img src="/images/studio/research-room-v1.webp" alt="A refined property records research room" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">When the route still doesn’t close</p><h2>We can contact the office<br>and keep the trail moving.</h2><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath <span aria-hidden="true">↗</span></a></div></section>
</main><script src="${AssetPaths.versioned("/studio-regional-records.js")}" defer></script>
`)
