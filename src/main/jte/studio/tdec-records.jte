@import com.example.septic.web.PageMeta
@import com.example.septic.data.model.ContentPage
@import com.example.septic.web.PageLink
@import com.example.septic.web.TennesseeCountyRouteView
@import com.example.septic.web.StudioCaseStudies.Study
@import com.example.septic.web.StudioGuideRoutes
@import com.example.septic.web.AssetPaths
@param ContentPage contentPage
@param java.util.List<TennesseeCountyRouteView> tennesseeCountyRoutes
@param java.util.List<PageLink> internalLinks
@param Study featuredStudy
@param String editorialLastReviewedAt = ""
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = contentPage.title(), heroImage = "/images/studio/tdec-desk-v1.webp", pageClass = "studio-tdec", pageStyles = "/studio-tdec.css", content = @`
<main id="main">
    <section class="tdec-hero" aria-labelledby="tdec-title"><img src="/images/studio/tdec-desk-v1.webp" alt="Illustrative Tennessee records desk overlooking a mountain valley" width="1796" height="876" fetchpriority="high"><div class="tdec-hero__shade"></div><div class="studio-wrap"><p class="studio-overline">Tennessee septic records</p><h1 id="tdec-title">The viewer stopped.<br>The search didn’t.</h1><p>Follow the county, the office, and the older property clues.</p><div><a class="tdec-light-button" href="#county-route">Find my county <span aria-hidden="true">↓</span></a><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath to investigate <span aria-hidden="true">→</span></a></div></div></section>

    <section class="tdec-routes studio-wrap" aria-labelledby="routes-title"><div><p class="studio-overline">Same state, different paths</p><h2 id="routes-title">Three routes to<br>the Tennessee file.</h2><p>A blocked viewer is an access failure—not a no-record response.</p></div><ol><li><span>01</span><div><h3>Official viewer</h3><p>Try the statewide SSDS route when it is accessible and confirm the property identity.</p></div></li><li><span>02</span><div><h3>Environmental Field Office</h3><p>Request the file through the office responsible for the county and preserve its response.</p></div></li><li><span>03</span><div><h3>Contract county</h3><p>Nine counties administer their own septic programs and maintain a different local route.</p></div></li></ol></section>

    <section class="tdec-finder" id="county-route" aria-labelledby="finder-title"><div class="tdec-finder__work"><p class="studio-overline">Find your route</p><h2 id="finder-title">Start with the county.</h2><p>We’ll point you to the responsible office and the next official step.</p><form data-tdec-studio-form><label>County<select required data-tdec-studio-county><option value="">Select a county</option>@for(var county : tennesseeCountyRoutes)<option value="${county.countyKey()}" data-county-name="${county.countyName()}" data-contract-county="${county.contractCounty()}" data-internal-path="${county.internalPath()}" data-field-office-name="${county.fieldOfficeName()}" data-field-office-url="${county.fieldOfficeUrl()}" data-records-url="${county.recordsUrl()}" data-records-label="${county.recordsLabel()}" data-records-hint="${county.recordsHint()}" data-request-email="${county.requestEmail()}">${county.countyName()}</option>@endfor</select></label><label>Property address <span>(optional)</span><input type="text" maxlength="160" autocomplete="street-address" placeholder="Street address, city and ZIP" data-tdec-studio-address></label><button class="studio-button" type="submit">Show my route <span aria-hidden="true">→</span></button></form><p class="tdec-finder__boundary">Nothing is submitted to an agency. A route is not a property record.</p><section class="tdec-result" data-tdec-studio-result hidden aria-live="polite" tabindex="-1"><p class="studio-overline">Responsible route</p><h3 data-tdec-studio-title></h3><p data-tdec-studio-copy></p><dl><div><dt>File owner</dt><dd data-tdec-studio-owner></dd></div><div><dt>Useful search keys</dt><dd data-tdec-studio-keys></dd></div></dl><div data-tdec-studio-actions></div></section></div><figure><img src="/images/studio/tdec-identity-v1.webp" alt="Illustrative property index, site sketch and archival record folders" width="1457" height="1080" loading="lazy"><figcaption>Illustrative research materials—not a Tennessee property file.</figcaption></figure></section>

    <section class="tdec-identity studio-wrap" aria-labelledby="identity-title"><div><p class="studio-overline">More details, a better search</p><h2 id="identity-title">Bring more than<br>the address.</h2><p>${contentPage.introCopy()}</p></div><ol><li><span>01</span><p>Parcel or tax-map ID</p></li><li><span>02</span><p>Current or prior owner</p></li><li><span>03</span><p>Subdivision and lot</p></li><li><span>04</span><p>Legal description</p></li><li><span>05</span><p>Permit number</p></li></ol></section>

    <section class="tdec-file" aria-labelledby="file-title"><div class="tdec-file__copy"><p class="studio-overline">The record route</p><h2 id="file-title">Read the file.<br>Keep its limits.</h2><ul><li>SSDS permit</li><li>Site sketch or as-built</li><li>Final approval</li><li>Repair history</li><li>Written no-record response</li></ul><p>Historical records explain documented approvals and work. They do not establish current condition or exact field location.</p></div><figure><img src="/images/studio/tdec-file-v1.webp" alt="Illustrative permit application, site sketch, final approval and repair history" width="1456" height="1080" loading="lazy"><figcaption>Illustrative record set—no property identity is shown.</figcaption></figure></section>

    @template.studio.research-proof(production = production, study = featuredStudy, countyEntry = true, imageOverride = "/images/studio/checklist-case-house-v1.webp", imageNote = "Illustrative setting", imageWidth = 1561, imageHeight = 1008)

    <section class="tdec-counties studio-wrap" aria-labelledby="counties-title"><div class="tdec-counties__heading"><div><p class="studio-overline">Tennessee county directory</p><h2 id="counties-title">The state route<br>ends locally.</h2></div><p>Each county may follow a different process. Start with the county to see the right route.</p></div><ul>@for(var county : tennesseeCountyRoutes.subList(0, Math.min(8, tennesseeCountyRoutes.size())))<li><span>${county.countyName()}</span><small>${county.contractCounty() ? "Contract county program" : county.fieldOfficeName() + " Environmental Field Office"}</small><a href="${county.hasInternalPath() ? county.internalPath() : county.recordsUrl()}">Open route <b aria-hidden="true">↗</b></a></li>@endfor</ul>@if(tennesseeCountyRoutes.size() > 8)<details><summary>Browse all Tennessee counties <span aria-hidden="true">+</span></summary><ul>@for(var county : tennesseeCountyRoutes.subList(8, tennesseeCountyRoutes.size()))<li><span>${county.countyName()}</span><small>${county.contractCounty() ? "Contract county program" : county.fieldOfficeName() + " Environmental Field Office"}</small><a href="${county.hasInternalPath() ? county.internalPath() : county.recordsUrl()}">Open route <b aria-hidden="true">↗</b></a></li>@endfor</ul></details>@endif</section>

    <section class="tdec-depth studio-wrap" aria-labelledby="depth-title"><div><p class="studio-overline">The complete workflow</p><h2 id="depth-title">Source first.<br>Conclusion second.</h2><p>${contentPage.targetReader()}</p></div><div>@for(var paragraph : contentPage.deepDiveParagraphs())<p>${paragraph}</p>@endfor<details><summary>Search risks and next steps <span aria-hidden="true">+</span></summary><h3>This route fits when</h3><ul>@for(var item : contentPage.fitBullets())<li>${item}</li>@endfor</ul><h3>What can break the easy answer</h3><ul>@for(var item : contentPage.lowEndBreakers())<li>${item}</li>@endfor</ul><h3>Decision sequence</h3><ol>@for(var item : contentPage.decisionSteps())<li>${item}</li>@endfor</ol><h3>What to prepare</h3><ul>@for(var item : contentPage.quotePrepChecklist())<li>${item}</li>@endfor</ul><h3>Why the route matters</h3><ul>@for(var item : contentPage.driverBullets())<li>${item}</li>@endfor</ul></details></div></section>

    <section class="tdec-related studio-wrap" aria-labelledby="related-title"><div><p class="studio-overline">Continue the research</p><h2 id="related-title">The next useful route.</h2></div><div><ul>@for(var link : internalLinks.subList(0, Math.min(6, internalLinks.size())))<li><a href="${StudioGuideRoutes.preview(link.path())}"><span>${link.compactTitle()}</span><small>${link.note()}</small><b aria-hidden="true">↗</b></a></li>@endfor</ul>@if(internalLinks.size() > 6)<details><summary>More Tennessee record guidance <span aria-hidden="true">+</span></summary><ul>@for(var link : internalLinks.subList(6, internalLinks.size()))<li><a href="${StudioGuideRoutes.preview(link.path())}"><span>${link.compactTitle()}</span><small>${link.note()}</small><b aria-hidden="true">↗</b></a></li>@endfor</ul></details>@endif</div></section>

    <section class="tdec-faq studio-wrap" aria-labelledby="faq-title"><p class="studio-overline">Common questions</p><h2 id="faq-title">Before you rely on the search.</h2>@for(var faq : contentPage.faqBlocks())<details><summary>${faq.question()} <span aria-hidden="true">+</span></summary><p>${faq.answer()}</p></details>@endfor<details class="tdec-sources"><summary>Official sources and limitations <span aria-hidden="true">+</span></summary><p>Reviewed ${editorialLastReviewedAt}. TDEC’s SSDS search is the statewide online route, while contract counties administer their own programs. A blocked viewer is not evidence that a property has no record.</p><nav><a href="https://www.tn.gov/environment/permits/water/septic-systems-permits.html" target="_blank" rel="noreferrer">TDEC septic systems program ↗</a><a href="https://www.tn.gov/environment/about-tdec/tdec-dataviewers.html" target="_blank" rel="noreferrer">TDEC Data and Map Viewers ↗</a><a href="https://dataviewers.tdec.tn.gov/dataviewers/f?p=175" target="_blank" rel="noreferrer">Groundwater Protection permits viewer ↗</a><a href="https://www.tn.gov/environment/contacts/field-offices.html" target="_blank" rel="noreferrer">Environmental Field Offices ↗</a><a href="https://www.tn.gov/environment/contacts/public-records-request.html" target="_blank" rel="noreferrer">TDEC public-records request ↗</a></nav><p><strong>Independent guide.</strong> SepticPath is not affiliated with TDEC or a Tennessee county.</p></details></section>

    <section class="tdec-next" aria-labelledby="tdec-next-title"><img src="/images/studio/checklist-closing-house-v1.webp" alt="" width="1774" height="887" loading="lazy"><div class="studio-wrap"><p class="studio-overline">Have the address?</p><h2 id="tdec-next-title">We can keep<br>going.</h2><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath <span aria-hidden="true">↗</span></a></div></section>
</main>
<script src="${AssetPaths.versioned("/studio-tdec.js")}" defer></script>
`)
