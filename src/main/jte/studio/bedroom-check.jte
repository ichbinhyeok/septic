@import com.example.septic.web.PageMeta
@import com.example.septic.web.StudioPreviewController.GuideState
@import com.example.septic.web.AssetPaths
@param java.util.List<GuideState> guideStates
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = "Compare listing and septic permit bedrooms", heroImage = "/images/studio/guides-lane-v1.webp", mobileHeroImage = "/images/studio/guides-mobile-v1.webp", pageClass = "studio-bedroom", pageStyles = "/studio-bedroom.css", content = @`
<main id="main">
    <section class="bedroom-hero"><picture><source media="(max-width:700px)" srcset="/images/studio/guides-mobile-v1.webp"><img src="/images/studio/guides-lane-v1.webp" alt="" width="1672" height="941" fetchpriority="high"></picture><div class="studio-wrap"><p class="studio-overline">The property file / Bedroom counts</p><h1>The listing tells <br>one story.<br>Check the file.</h1><p>Compare bedroom counts before your<br>next property decision.</p><a class="studio-button" href="#bedroom-compare">Compare the counts <span>↓</span></a></div></section>
    <section class="bedroom-workspace studio-wrap" id="bedroom-compare" data-bedroom-permit-checker aria-labelledby="compare-heading">
        <div class="bedroom-intro"><p class="studio-overline">A records-first check</p><h2 id="compare-heading">Does the listing bedroom count match the septic permit?</h2><p>Enter the listing count and what you found in the septic file.<br>This compares your inputs—it does not retrieve or verify a permit.</p><p class="studio-fine">Nothing saved. Need this inside another workflow? <a href="${com.example.septic.web.StudioGuideRoutes.route("/embed/septic-bedroom-permit-checker/", production)}">Open the embeddable checker</a>.</p></div>
        <div class="bedroom-columns"><form data-bedroom-permit-form>
            <fieldset class="bedroom-counts"><legend>Compare the bedroom counts</legend><label><span>In the listing</span><input type="number" min="1" max="12" step="1" inputmode="numeric" required placeholder="3" data-bedroom-listing-count><small>Advertised bedrooms</small></label><label><span>In the septic permit</span><select data-bedroom-permit-count><option value="">Unknown</option>@for(int n = 1; n <= 12; n++)<option value="${n}">${n}</option>@endfor</select><small>From the official approval</small></label></fieldset>
            <label>Property state<select required data-bedroom-state><option value="" selected disabled>Choose a state</option>@for(var state : guideStates)<option value="${state.code()}">${state.name()}</option>@endfor</select></label>
            <label>What have you reviewed?<select data-bedroom-file-status><option value="not_checked">I have not checked an official file</option><option value="official">Official permit or approval reviewed</option><option value="missing">No file found yet</option><option value="conflicting">Seller, tax, or permit records conflict</option></select></label>
            <details class="bedroom-address"><summary>Add a property address <span>+</span></summary><label>Property address (optional)<input type="text" maxlength="180" autocomplete="street-address" data-bedroom-address></label><p>Included only in the note you copy or download.</p></details>
            <button class="studio-button" type="submit" data-bedroom-submit>Compare the counts <span>↗</span></button><p class="studio-fine">Runs in your browser. Your address, counts and result are not uploaded or saved.</p><noscript><p>Enable JavaScript to compare your inputs, or <a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">ask us about your file</a>.</p></noscript>
        </form><aside class="bedroom-aside"><p class="studio-overline">Before you rely on a number</p><h3>The record<br>comes first.</h3><ol><li><span>01</span><div><h4>Official approval</h4><p>A room count or seller statement is not a septic-capacity answer.</p></div></li><li><span>02</span><div><h4>Property match</h4><p>Check that the address, parcel and approval belong to this property.</p></div></li><li><span>03</span><div><h4>Written clarification</h4><p>Ask the responsible office to explain gaps or conflicting records.</p></div></li></ol><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/", production)}">Find the records route <span>↗</span></a></aside></div>
        <section class="bedroom-result" data-bedroom-result hidden aria-live="polite" aria-labelledby="bedroom-result-title"><p class="studio-overline" data-bedroom-result-label></p><dl class="bedroom-facts" data-bedroom-result-facts aria-label="Bedroom count comparison"></dl><h2 id="bedroom-result-title" tabindex="-1" data-bedroom-result-heading></h2><p data-bedroom-result-body></p><div class="bedroom-result-grid"><div><h3>Your next records questions.</h3><ol data-bedroom-result-steps></ol><div class="bedroom-links"><a href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/", production)}" data-track-source-context="bedroom_checker_result_address">Find the official records route ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/#draft-request", production)}" data-track-source-context="bedroom_checker_result_request">Prepare a records request ↗</a></div></div><div class="bedroom-note"><p class="studio-overline">Keep the conversation clear</p><label for="bedroom-note">Your transaction note</label><textarea id="bedroom-note" readonly rows="12" data-bedroom-result-note></textarea><div class="bedroom-actions"><button class="studio-button" type="button" data-bedroom-copy>Copy transaction note</button><button type="button" data-bedroom-download>Download .txt ↓</button></div></div></div><p class="studio-fine">This is a comparison of information you entered, not an engineering, permit, MLS, lender, or legal compliance determination.</p></section>
    </section>
    <section class="bedroom-file"><img src="/images/studio/work-desk-v1.webp" alt="Illustrative property research folder on a desk" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">Beyond the count</p><h2>Keep the question<br>tied to the file.</h2><p>A matching number is a starting point.<br>Keep the approval, layout and written responses together.</p></div></section>
    <section class="studio-process"><div class="studio-wrap"><p class="studio-overline">A clear way forward</p><h2>From a number to the next step.</h2><ol class="studio-steps"><li><span class="studio-steps__number">01</span><div><h3>Read the approval.</h3><p>Start with the permit or official response, not an assumption about room count.</p></div><a href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/", production)}">Find records <span>↗</span></a></li><li><span class="studio-steps__number">02</span><div><h3>Ask about the gap.</h3><p>Request the controlling approval and a written explanation of conflicting information.</p></div><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-records-request-builder/", production)}">Build the full request <span>↗</span></a></li><li><span class="studio-steps__number">03</span><div><h3>Keep the response.</h3><p>Preserve the source and ask the responsible local professional what comes next.</p></div><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">Review my file <span>↗</span></a></li></ol></div></section>
    <section class="studio-closing"><img src="/images/studio/oak-pasture-v1.webp" alt="" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">You don’t need every answer yet</p><h2>Have a file.<br>Still have questions?</h2><p>Share what you have and what you need to understand.</p><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">Ask about my file <span>↗</span></a></div></section>
</main>
<script src="${AssetPaths.versioned("/studio-bedroom.js")}" defer></script>
`)
