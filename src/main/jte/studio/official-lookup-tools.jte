@import com.example.septic.web.PageMeta
@import com.example.septic.data.model.ContentPage
@import com.example.septic.web.PageLink
@import com.example.septic.web.CountyWorkflowFieldView
@import com.example.septic.web.StudioPreviewController.GuideState
@import com.example.septic.web.StudioCaseStudies.Study
@import com.example.septic.web.StudioGuideRoutes
@import com.example.septic.web.AssetPaths
@param ContentPage contentPage
@param java.util.List<GuideState> guideStates
@param java.util.List<PageLink> internalLinks
@param java.util.List<CountyWorkflowFieldView> contentOfficialFilePathRows
@param Study featuredStudy
@param String editorialLastReviewedAt = ""
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = contentPage.title(), heroImage = "/images/studio/official-lookup-hero-v1.webp", pageClass = "studio-official-lookup", pageStyles = "/studio-official-lookup.css", content = @`
<main id="main">
    <section class="lookup-hero" aria-labelledby="lookup-title"><img src="/images/studio/official-lookup-hero-v1.webp" alt="Illustrative United States property-records research desk with maps and archival files" width="1792" height="896" fetchpriority="high"><div class="lookup-hero__shade"></div><div class="studio-wrap"><p class="studio-overline">${contentPage.title()}</p><h1 id="lookup-title">Find the official source.<br>Then follow the file.</h1><p>State portal, county office, or targeted request—we’ll help you choose the route.</p><div><a class="lookup-light-button" href="#route-finder">Choose a route <span aria-hidden="true">↓</span></a><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath to investigate <span aria-hidden="true">→</span></a></div></div></section>

    <section class="lookup-choices studio-wrap" aria-label="Three official lookup routes"><ol><li><span>01</span><div><h2>State portal</h2><p>Start with the state’s official database or program page.</p></div></li><li><span>02</span><div><h2>County office</h2><p>Find the health, environmental health, or delegated authority.</p></div></li><li><span>03</span><div><h2>Targeted request</h2><p>Ask for the permit, drawing, approval, repair file, or no-record response.</p></div></li></ol></section>

    <section class="lookup-finder" id="route-finder" aria-labelledby="route-finder-title"><div class="lookup-finder__work"><p class="studio-overline">Find your route</p><h2 id="route-finder-title">Official tools by<br>state and county.</h2><p>Choose a state. We’ll preserve the county handoff when the state is not the final file owner.</p><form data-official-lookup-form><label>State<select required data-official-lookup-state><option value="">Select a state</option>@for(var state : guideStates)<option value="${state.slug()}" data-name="${state.name()}" data-code="${state.code()}" data-published="${state.published()}">${state.name()}</option>@endfor</select></label><label>County <span>(optional)</span><input type="text" maxlength="90" autocomplete="address-level2" placeholder="County name" data-official-lookup-county></label><button class="studio-button" type="submit">Show route <span aria-hidden="true">→</span></button></form><p class="lookup-finder__boundary">A route identifies where to search. It does not confirm a record exists.</p><section class="lookup-result" data-official-lookup-result hidden aria-live="polite" tabindex="-1"><p class="studio-overline">Recommended start</p><h3 data-official-lookup-title></h3><p data-official-lookup-copy></p><div data-official-lookup-actions></div></section></div><figure><img src="/images/studio/official-lookup-map-v1.webp" alt="Illustrative United States map, county atlas and property index" width="1456" height="1080" loading="lazy"><figcaption>Illustrative research materials—not a property-specific lookup.</figcaption></figure></section>

    <section class="lookup-routes studio-wrap" aria-labelledby="lookup-routes-title"><div class="lookup-routes__heading"><div><p class="studio-overline">Five common starting points</p><h2 id="lookup-routes-title">The label changes.<br>The discipline doesn’t.</h2></div><p>Open the official program first, then use our guide to understand who owns the file and what to request next.</p></div><ol><li><span>TN / TDEC</span><h3>Tennessee SSDS records</h3><div><a href="https://www.tn.gov/environment/permits/water/septic-systems-permits.html" target="_blank" rel="noreferrer">Official source ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/tdec-septic-records/", production)}">Use our route →</a></div></li><li><span>NC / County EH</span><h3>North Carolina permit lookup</h3><div><a href="https://www.deq.nc.gov/about/divisions/water-resources/water-resources-public-information/public-records" target="_blank" rel="noreferrer">Official source ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/north-carolina-septic-permit-lookup/", production)}">Use our route →</a></div></li><li><span>TX / OSSF</span><h3>Texas local-authority records</h3><div><a href="https://www.tceq.texas.gov/permitting/ossf" target="_blank" rel="noreferrer">Official source ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/texas-ossf-records-search/", production)}">Use our route →</a></div></li><li><span>SC / SCDES</span><h3>South Carolina septic permits</h3><div><a href="https://des.sc.gov/permits-regulations/septic-tanks" target="_blank" rel="noreferrer">Official source ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/dhec-septic-permit-lookup/", production)}">Use our route →</a></div></li><li><span>FL / OSTDS</span><h3>Florida county health records</h3><div><a href="https://floridadep.gov/water/onsite-sewage" target="_blank" rel="noreferrer">Official source ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/florida-ostds-permit-lookup/", production)}">Use our route →</a></div></li></ol></section>

    <section class="lookup-artifacts" aria-labelledby="lookup-artifacts-title"><figure><img src="/images/studio/official-lookup-files-v1.webp" alt="Illustrative permit, as-built sketch, final approval and repair-history file" width="1456" height="1080" loading="lazy"><figcaption>Illustrative record set with no customer identity.</figcaption></figure><div><p class="studio-overline">Beyond the first result</p><h2 id="lookup-artifacts-title">A search result is only<br>the first artifact.</h2><p>${contentPage.introCopy()}</p><ul><li>Permit copy</li><li>As-built or site sketch</li><li>Final approval</li><li>Repair history</li><li>Written no-record response</li></ul></div></section>

    @template.studio.research-proof(production = production, study = featuredStudy, countyEntry = true, imageOverride = "/images/studio/checklist-case-house-v1.webp", imageNote = "Illustrative setting", imageWidth = 1561, imageHeight = 1008)

    <section class="lookup-method studio-wrap" aria-labelledby="lookup-method-title"><div><p class="studio-overline">How SepticPath works</p><h2 id="lookup-method-title">The portal is a doorway.<br>Not the conclusion.</h2><p>${contentPage.targetReader()}</p></div><ol>@for(var row : contentOfficialFilePathRows)<li><span aria-hidden="true">→</span><h3>${row.label()}</h3><p>${row.value()}</p></li>@endfor</ol></section>

    <section class="lookup-depth studio-wrap" aria-labelledby="lookup-depth-title"><div><p class="studio-overline">The complete workflow</p><h2 id="lookup-depth-title">Search broadly.<br>Conclude carefully.</h2><ul>@for(var item : contentPage.fitBullets())<li>${item}</li>@endfor</ul></div><div>@for(var paragraph : contentPage.deepDiveParagraphs())<p>${paragraph}</p>@endfor<details><summary>Search risks and next steps <span aria-hidden="true">+</span></summary><h3>What can break the easy answer</h3><ul>@for(var item : contentPage.lowEndBreakers())<li>${item}</li>@endfor</ul><h3>Decision sequence</h3><ol>@for(var item : contentPage.decisionSteps())<li>${item}</li>@endfor</ol><h3>What to prepare</h3><ul>@for(var item : contentPage.quotePrepChecklist())<li>${item}</li>@endfor</ul><h3>Why the route matters</h3><ul>@for(var item : contentPage.driverBullets())<li>${item}</li>@endfor</ul></details></div></section>

    <section class="lookup-related studio-wrap" aria-labelledby="lookup-related-title"><div><p class="studio-overline">Continue the research</p><h2 id="lookup-related-title">Open the next<br>useful route.</h2></div><div><ul>@for(var link : internalLinks.subList(0, Math.min(7, internalLinks.size())))<li><a href="${StudioGuideRoutes.preview(link.path())}"><span>${link.compactTitle()}</span><small>${link.note()}</small><b aria-hidden="true">↗</b></a></li>@endfor</ul>@if(internalLinks.size() > 7)<details><summary>More lookup and request guidance <span aria-hidden="true">+</span></summary><ul>@for(var link : internalLinks.subList(7, internalLinks.size()))<li><a href="${StudioGuideRoutes.preview(link.path())}"><span>${link.compactTitle()}</span><small>${link.note()}</small><b aria-hidden="true">↗</b></a></li>@endfor</ul></details>@endif</div></section>

    <section class="lookup-faq studio-wrap" aria-labelledby="lookup-faq-title"><p class="studio-overline">Common questions</p><h2 id="lookup-faq-title">Before you trust the lookup.</h2>@for(var faq : contentPage.faqBlocks())<details><summary>${faq.question()} <span aria-hidden="true">+</span></summary><p>${faq.answer()}</p></details>@endfor<details><summary>Editorial scope and limitations <span aria-hidden="true">+</span></summary><p>Reviewed ${editorialLastReviewedAt}. Official portals and office routes can change. SepticPath is independent and does not represent a state, county, health department, or permitting agency.</p></details></section>

    <section class="lookup-next" aria-labelledby="lookup-next-title"><img src="/images/studio/checklist-closing-house-v1.webp" alt="" width="1774" height="887" loading="lazy"><div class="studio-wrap"><p class="studio-overline">Have the property?</p><h2 id="lookup-next-title">Same land.<br>A clearer tomorrow.</h2><p>Give us the address and question. We’ll follow the source trail.</p><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath <span aria-hidden="true">↗</span></a></div></section>
</main>
<script src="${AssetPaths.versioned("/studio-official-lookup.js")}" defer></script>
`)
