@import com.example.septic.web.PageMeta
@import com.example.septic.data.model.ContentPage
@import com.example.septic.web.PageLink
@import com.example.septic.web.StateMoneyPageLink
@import com.example.septic.web.AssetPaths
@param ContentPage contentPage
@param java.util.List<PageLink> internalLinks = java.util.List.of()
@param java.util.List<StateMoneyPageLink> stateMoneyPageLinks = java.util.List.of()
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = contentPage.title(), heroImage = "/images/studio/county-property-v1.webp", mobileHeroImage = "/images/studio/guides-mobile-v1.webp", pageClass = "studio-article", pageStyles = "/studio-article.css", content = @`
<main id="main">
    <section class="article-hero"><picture><source media="(max-width:700px)" srcset="/images/studio/guides-mobile-v1.webp"><img src="/images/studio/county-property-v1.webp" alt="" width="1672" height="941" fetchpriority="high"></picture><div class="studio-wrap"><p class="studio-overline">The buyer’s field guide</p><h1>${contentPage.title()}</h1><p>The home is only part of the story.<br>Get to know the file behind it.</p><a class="studio-button" href="#buyer-records">Start with the records <span aria-hidden="true">↓</span></a></div></section>
    <div class="article-breadcrumb studio-wrap"><a href="${com.example.septic.web.StudioGuideRoutes.route("/states/", production)}">Property guides</a><span aria-hidden="true">/</span><span>Buying a home</span></div>
    <div class="article-layout studio-wrap"><aside class="article-sidebar"><button class="article-toc-toggle" type="button" aria-expanded="true" aria-controls="article-toc" hidden>In this guide <span aria-hidden="true">+</span></button><nav id="article-toc" aria-label="In this guide"><p class="studio-overline">In this guide</p><a href="#buyer-records">01 &nbsp; Read the file</a><a href="#seller-claim-records">02 &nbsp; Check the seller’s story</a><a href="#buyer-steps">03 &nbsp; Plan the next steps</a><a href="#buyer-checklist">04 &nbsp; Before you close</a><a href="#buyer-questions">05 &nbsp; Common questions</a><a href="#buyer-local">06 &nbsp; Local guidance</a></nav><a class="article-help" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Have a property in mind?<br><span>Ask SepticPath ↗</span></a></aside>
    <article class="article-body" aria-label="Buyer guide">
        <section id="buyer-records"><p class="article-lede">${contentPage.introCopy()}</p><h2>Know what the file can tell you.</h2><div class="article-reading-notes">@for(int i = 0; i < contentPage.deepDiveParagraphs().size(); i++)<div class="article-reading-note">@if(i < 4)<h3>${java.util.List.of("Start with the purchase questions", "Separate claims from evidence", "Match the file to the property", "Keep the open questions visible").get(i)}</h3>@endif<p>${contentPage.deepDiveParagraphs().get(i)}</p></div>@endfor</div>
        <div class="article-actions"><a href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/", production)}">Find your records route ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-bedroom-permit-checker/", production)}">Compare bedroom counts ↗</a></div></section>
        <figure class="article-photo article-photo--buyer"><img src="/images/studio/buyer-folio-v1.webp" alt="Buyer-guide booklet with sections for property records, inspection and open questions" width="1672" height="941" loading="lazy"><figcaption>Keep the approval, layout and supporting history together.</figcaption></figure>
        <section id="seller-claim-records"><p class="studio-overline">From a claim to a question</p><h2>Does the record support the seller’s statement?</h2><p>Write the claim as a question, then identify the document that could answer it. Keep an unanswered question open until the evidence supports a conclusion.</p>
        <div class="article-claim article-claim--featured"><p class="studio-overline">01 / Tank count · Illustrative review scenario</p><h3>“There are two tanks.”<br>The drawing shows one.</h3><p>One tank on one historical drawing confirms what that drawing depicts. It does not establish whether a second tank was installed later, omitted from that sheet, or never present.</p><p>Check the property match and drawing date, then request later installation or repair records and the complete file. A professional field check may still be needed. The useful outcome is a precise unanswered question, not an unsupported yes or no.</p></div>
        <div class="article-claim"><p class="studio-overline">02 / Bedroom count</p><h3>“The system supports the listed bedrooms.”</h3><p>Compare the recorded design basis with the listing. Tank size alone should not be substituted for an approved bedroom count.</p><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/septic-bedroom-permit-checker/", production)}">Compare the numbers <span>↗</span></a></div>
        <div class="article-claim"><p class="studio-overline">03 / Repair history</p><h3>“The drain field was replaced.”</h3><p>Ask for the repair or replacement file and the related inspection or approval record. A quote or invoice and an official approval have different roles.</p><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/septic-transfer-compliance/#sale-record-packet", production)}">See the document checklist for a sale <span>↗</span></a></div></section>
        <section id="buyer-steps"><p class="studio-overline">Put the questions in order</p><h2>A clearer path through due diligence.</h2><ol class="article-steps">@for(int i = 0; i < contentPage.decisionSteps().size(); i++)<li><span aria-hidden="true">0${i + 1}</span><p>${contentPage.decisionSteps().get(i)}</p></li>@endfor</ol><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/official-septic-lookup-tools/#draft-request", production)}">Prepare your records request <span>↗</span></a>
        <h3>What can change the risk?</h3><ul>@for(var item : contentPage.lowEndBreakers())<li>${item}</li>@endfor</ul><details class="article-disclosure"><summary>How inspection findings affect planning <span aria-hidden="true">+</span></summary><ul>@for(var item : contentPage.driverBullets())<li>${item}</li>@endfor</ul><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/septic-system-cost-calculator/", production)}">Open the planning estimator <span>↗</span></a></details></section>
        <figure class="article-photo article-photo--land"><img src="/images/studio/oak-pasture-v1.webp" alt="Illustrative open pasture framed by mature trees" width="1672" height="941" loading="lazy"><figcaption>The record describes the past. A current inspection answers a different question.</figcaption></figure>
        <section class="article-checklist" id="buyer-checklist"><p class="studio-overline">For the next conversation</p><h2>Before you close.</h2><p>Keep these items together for your agent, inspector or records contact.</p><ul>@for(var item : contentPage.quotePrepChecklist())<li>${item}</li>@endfor</ul><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">Ask about the file <span>↗</span></a></section>
        <section id="buyer-questions"><p class="studio-overline">Common questions</p><h2>A little more clarity.</h2>@for(var faq : contentPage.faqBlocks())<details class="article-disclosure"><summary>${faq.question()}<span aria-hidden="true">+</span></summary><p>${faq.answer()}</p></details>@endfor</section>
        <section id="buyer-local"><p class="studio-overline">The local details matter</p><h2>Find your state’s guide.</h2><p>Keep the property’s local records and inspection path in view.</p><ul class="article-link-list" id="article-states">@for(var link : stateMoneyPageLinks)<li><a href="${link.path().replace("/buying-a-house-with-a-septic-system/", "/buying-a-house-with-a-septic-system/")}">${link.stateName()}<span aria-hidden="true">↗</span></a></li>@endfor</ul><button class="article-states-toggle" type="button" aria-expanded="false" aria-controls="article-states" hidden>Show all state guides ↓</button><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/states/", production)}">Browse all states <span>↗</span></a></section>
        <section id="buyer-related"><p class="studio-overline">Continue your research</p><h2>The next useful read.</h2><ul class="article-link-list">@for(var link : internalLinks)<li><a href="${com.example.septic.web.StudioGuideRoutes.preview(link.path())}">${link.title()}<span aria-hidden="true">↗</span></a></li>@endfor</ul><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/", production)}">Explore real record-help cases <span>↗</span></a></section>
        <details class="article-disclosure article-audience"><summary>Who this guide is for <span aria-hidden="true">+</span></summary><p>${contentPage.targetReader()}</p><ul>@for(var item : contentPage.fitBullets())<li>${item}</li>@endfor</ul></details>
    </article></div>
    <section class="studio-closing article-closing"><img src="/images/studio/oak-pasture-v1.webp" alt="" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">You don’t need every answer yet</p><h2>A clearer file.<br>A better next question.</h2><p>Tell us about the property and what you need to understand.</p><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath <span>↗</span></a></div></section>
</main>
<script src="${AssetPaths.versioned("/studio-article.js")}" defer></script>
`)
