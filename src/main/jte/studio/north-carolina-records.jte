@import com.example.septic.web.PageMeta
@import com.example.septic.data.model.ContentPage
@import com.example.septic.data.model.CountyRecordsPage
@import com.example.septic.web.PageLink
@import com.example.septic.web.CountyWorkflowFieldView
@import com.example.septic.web.StudioCaseStudies.Study
@import com.example.septic.web.StudioGuideRoutes
@import com.example.septic.web.AssetPaths
@param ContentPage contentPage
@param java.util.List<CountyRecordsPage> northCarolinaCountyRoutes
@param java.util.List<CountyRecordsPage> northCarolinaPriorityCountyRoutes
@param java.util.List<PageLink> internalLinks
@param java.util.List<CountyWorkflowFieldView> contentOfficialFilePathRows
@param Study featuredStudy
@param String editorialLastReviewedAt = ""
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = contentPage.title(), heroImage = "/images/studio/property-hero-v1.webp", pageClass = "studio-nc-records", pageStyles = "/studio-nc-records.css", content = @`
<main id="main">
    <section class="nc-hero" aria-labelledby="nc-title"><img src="/images/studio/property-hero-v1.webp" alt="Illustrative rural property in a wooded mountain landscape" width="1792" height="960" fetchpriority="high"><div class="nc-hero__shade"></div><div class="studio-wrap"><p class="studio-overline">${contentPage.title()}</p><h1 id="nc-title">The county holds<br>the answer.</h1><p>Find Environmental Health. Carry the right property clues. Follow the file.</p><div><a class="nc-light-button" href="#nc-county-route">Find my county <span aria-hidden="true">↓</span></a><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath to investigate <span aria-hidden="true">→</span></a></div></div></section>

    <section class="nc-principle studio-wrap" aria-labelledby="nc-principle-title"><div><p class="studio-overline">North Carolina records</p><h2 id="nc-principle-title">One state.<br>County-held files.</h2><p>A statewide program sets the framework, but property-level septic records usually resolve through the county Environmental Health office.</p></div><ol><li><span>01</span><div><h3>Choose the county</h3><p>Identify the office responsible for the property.</p></div></li><li><span>02</span><div><h3>Carry match keys</h3><p>Address, PIN, owner, subdivision, lot, or permit number.</p></div></li><li><span>03</span><div><h3>Request the complete file</h3><p>Permit, authorization, operation approval, drawing, and repair history.</p></div></li></ol></section>

    <section class="nc-finder" id="nc-county-route" aria-labelledby="nc-finder-title"><div class="nc-finder__work"><p class="studio-overline">County route finder</p><h2 id="nc-finder-title">Start where the<br>record lives.</h2><p>Select a published county workflow. Nothing is sent to the county.</p><form data-nc-studio-form><label>County<select required data-nc-studio-county><option value="">Select a county</option>@for(var county : northCarolinaCountyRoutes)<option value="${county.countySlug()}" data-name="${county.countyName()}" data-internal-path="${county.path("north-carolina")}" data-records-url="${county.recordsUrl()}" data-records-label="${county.recordsLabel()}">${county.countyName()}</option>@endfor</select></label><label>Property clue <span>(optional)</span><input type="text" maxlength="140" placeholder="Address, PIN, owner, or permit number" data-nc-studio-clue></label><button class="studio-button" type="submit">Prepare county route <span aria-hidden="true">→</span></button></form><p class="nc-finder__boundary">A route is not a property record, permit confirmation, or no-record response.</p><section class="nc-result" data-nc-studio-result hidden aria-live="polite" tabindex="-1"><p class="studio-overline">County route prepared</p><h3 data-nc-studio-title></h3><p data-nc-studio-copy></p><dl><div><dt>Carry these clues</dt><dd data-nc-studio-keys></dd></div><div><dt>Ask for</dt><dd>Improvement Permit, Construction Authorization, Operation Permit or final approval, approved layout, and repair records.</dd></div></dl><div data-nc-studio-actions></div></section></div><figure><img src="/images/studio/official-lookup-map-v1.webp" alt="Illustrative United States and county research map with a property index" width="1456" height="1080" loading="lazy"><figcaption>Illustrative research materials—not a North Carolina property file.</figcaption></figure></section>

    <section class="nc-counties studio-wrap" aria-labelledby="nc-counties-title"><div class="nc-counties__heading"><div><p class="studio-overline">Published county workflows</p><h2 id="nc-counties-title">Go straight to<br>the local route.</h2></div><p>These pages explain the official portal, form, email, or phone path—and what to do when the first search is empty.</p></div><ul>@for(var county : northCarolinaPriorityCountyRoutes.subList(0, Math.min(8, northCarolinaPriorityCountyRoutes.size())))<li><span>${county.countyName()}</span><small>${county.officeLabel()}</small><a href="${com.example.septic.web.StudioGuideRoutes.route(county.path("north-carolina"), production)}">Open route <b aria-hidden="true">↗</b></a></li>@endfor</ul>@if(northCarolinaPriorityCountyRoutes.size() > 8)<details><summary>More high-demand county routes <span aria-hidden="true">+</span></summary><ul>@for(var county : northCarolinaPriorityCountyRoutes.subList(8, northCarolinaPriorityCountyRoutes.size()))<li><span>${county.countyName()}</span><small>${county.officeLabel()}</small><a href="${com.example.septic.web.StudioGuideRoutes.route(county.path("north-carolina"), production)}">Open route <b aria-hidden="true">↗</b></a></li>@endfor</ul></details>@endif@if(northCarolinaCountyRoutes.size() > northCarolinaPriorityCountyRoutes.size())<details><summary>Browse every published North Carolina county <span aria-hidden="true">+</span></summary><ul>@for(var county : northCarolinaCountyRoutes)@if(!northCarolinaPriorityCountyRoutes.contains(county))<li><span>${county.countyName()}</span><small>${county.officeLabel()}</small><a href="${com.example.septic.web.StudioGuideRoutes.route(county.path("north-carolina"), production)}">Open route <b aria-hidden="true">↗</b></a></li>@endif@endfor</ul></details>@endif</section>

    <section class="nc-file" aria-labelledby="nc-file-title"><figure><img src="/images/studio/file-dividers-v1.webp" alt="Illustrative permit history, site plan, repair record and agency correspondence file dividers" width="1792" height="960" loading="lazy"><figcaption>Illustrative file categories with no property identity.</figcaption></figure><div><p class="studio-overline">Ask for the file, not a yes or no</p><h2 id="nc-file-title">The permit result<br>is only the start.</h2><p>${contentPage.introCopy()}</p><ul><li>Improvement Permit</li><li>Construction Authorization</li><li>Operation Permit or final approval</li><li>Approved layout or site sketch</li><li>Repair or modification records</li></ul></div></section>

    @template.studio.research-proof(production = production, study = featuredStudy, countyEntry = false, imageOverride = "/images/studio/checklist-case-house-v1.webp", imageNote = "Illustrative setting", imageWidth = 1561, imageHeight = 1008)

    <section class="nc-method studio-wrap" aria-labelledby="nc-method-title"><div><p class="studio-overline">The county-first method</p><h2 id="nc-method-title">Find the owner.<br>Then test the story.</h2><p>${contentPage.targetReader()}</p></div><ol>@for(var row : contentOfficialFilePathRows)<li><span aria-hidden="true">→</span><h3>${row.label()}</h3><p>${row.value()}</p></li>@endfor</ol></section>

    <section class="nc-depth studio-wrap" aria-labelledby="nc-depth-title"><div><p class="studio-overline">The complete workflow</p><h2 id="nc-depth-title">An empty portal<br>is not no record.</h2><ul>@for(var item : contentPage.fitBullets())<li>${item}</li>@endfor</ul></div><div>@for(var paragraph : contentPage.deepDiveParagraphs())<p>${paragraph}</p>@endfor<details><summary>Search risks and next steps <span aria-hidden="true">+</span></summary><h3>What can break the easy answer</h3><ul>@for(var item : contentPage.lowEndBreakers())<li>${item}</li>@endfor</ul><h3>Decision sequence</h3><ol>@for(var item : contentPage.decisionSteps())<li>${item}</li>@endfor</ol><h3>What to prepare</h3><ul>@for(var item : contentPage.quotePrepChecklist())<li>${item}</li>@endfor</ul><h3>Why the route matters</h3><ul>@for(var item : contentPage.driverBullets())<li>${item}</li>@endfor</ul></details></div></section>

    <section class="nc-related studio-wrap" aria-labelledby="nc-related-title"><div><p class="studio-overline">Continue the research</p><h2 id="nc-related-title">The next useful<br>North Carolina route.</h2></div><div><ul>@for(var link : internalLinks.subList(0, Math.min(7, internalLinks.size())))<li><a href="${StudioGuideRoutes.preview(link.path())}"><span>${link.compactTitle()}</span><small>${link.note()}</small><b aria-hidden="true">↗</b></a></li>@endfor</ul>@if(internalLinks.size() > 7)<details><summary>More record and request guidance <span aria-hidden="true">+</span></summary><ul>@for(var link : internalLinks.subList(7, internalLinks.size()))<li><a href="${StudioGuideRoutes.preview(link.path())}"><span>${link.compactTitle()}</span><small>${link.note()}</small><b aria-hidden="true">↗</b></a></li>@endfor</ul></details>@endif</div></section>

    <section class="nc-faq studio-wrap" aria-labelledby="nc-faq-title"><p class="studio-overline">Common questions</p><h2 id="nc-faq-title">Before you rely on the county file.</h2>@for(var faq : contentPage.faqBlocks())<details><summary>${faq.question()} <span aria-hidden="true">+</span></summary><p>${faq.answer()}</p></details>@endfor<details><summary>Official sources and limitations <span aria-hidden="true">+</span></summary><p>Reviewed ${editorialLastReviewedAt}. North Carolina’s On-Site Wastewater Program provides statewide oversight, while property-level permits and failed-system questions generally route through county Environmental Health.</p><nav><a href="https://www.dph.ncdhhs.gov/programs/environmental-health/site-water-protection-branch/site-wastewater-program" target="_blank" rel="noreferrer">NC On-Site Wastewater Program ↗</a><a href="https://www.dph.ncdhhs.gov/environmental-health/ehs-directory-june-2026/download?attachment=" target="_blank" rel="noreferrer">Environmental Health staff by county ↗</a></nav><p><strong>Independent guide.</strong> SepticPath is not affiliated with NCDHHS or a North Carolina county.</p></details></section>

    <section class="nc-next" aria-labelledby="nc-next-title"><img src="/images/studio/checklist-closing-house-v1.webp" alt="" width="1774" height="887" loading="lazy"><div class="studio-wrap"><p class="studio-overline">Have the property?</p><h2 id="nc-next-title">We can follow<br>the county trail.</h2><p>Give us the address, county, and question.</p><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Ask SepticPath <span aria-hidden="true">↗</span></a></div></section>
</main>
<script src="${AssetPaths.versioned("/studio-nc-records.js")}" defer></script>
`)
