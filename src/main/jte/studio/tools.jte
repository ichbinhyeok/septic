@import com.example.septic.web.PageMeta
@import com.example.septic.web.StudioPreviewController.GuideState
@import com.example.septic.web.AssetPaths
@param java.util.List<GuideState> guideStates
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = "Find a records route & prepare a request", heroImage = "/images/studio/work-desk-v1.webp", mobileHeroImage = "/images/studio/mobile-research-v1.webp", pageClass = "studio-tools", pageStyles = "/studio-tools.css", content = @`
<main id="main">
    <section class="tools-hero" aria-labelledby="tools-title"><picture><source media="(max-width: 700px)" srcset="/images/studio/mobile-research-v1.webp"><img src="/images/studio/work-desk-v1.webp" alt="" width="1672" height="941" fetchpriority="high"></picture><div class="studio-wrap"><p class="studio-overline">The records workspace</p><h1 id="tools-title">Find the source.<br>Make the next move.</h1><p>A starting point for your property’s paper trail.</p></div></section>
    <nav class="tools-jump studio-wrap" aria-label="Workspace sections"><a href="#find-route">01 &nbsp; Find the records route <span>↓</span></a><a href="#draft-request">02 &nbsp; Draft a request <span>↓</span></a></nav>
    <section class="tools-find studio-wrap" id="find-route" aria-labelledby="find-title">
        <div><p class="studio-overline">01 / Locate the source</p><h2 id="find-title">Start with the address.</h2><p>Match a U.S. address to its county, then explore the available records route.</p>
            <form id="route-form"><label for="route-address">Full property address</label><input id="route-address" name="address" required minlength="8" maxlength="180" autocomplete="street-address" placeholder="Street address, city, state and ZIP" aria-describedby="route-privacy"><button class="studio-button" id="route-submit" type="submit">Find the official route <span aria-hidden="true">↗</span></button></form>
            <p class="studio-fine" id="route-privacy">Lookup sends the address to the U.S. Census geocoder. This workspace does not save your draft in browser storage.</p><a class="studio-text-link" href="${com.example.septic.web.StudioGuideRoutes.route("/states/", production)}">Prefer to browse by state? <span>↗</span></a>
            <noscript><p>Enable JavaScript for address lookup and drafting, or <a href="${com.example.septic.web.StudioGuideRoutes.route("/states/", production)}">browse the guides</a>.</p></noscript>
        </div>
        <aside class="tools-explainer"><p class="studio-overline">What happens next</p><ol><li><span>01</span><div><h3>County match</h3><p>Check the matched address before continuing.</p></div></li><li><span>02</span><div><h3>Official source</h3><p>See the available office or records route.</p></div></li><li><span>03</span><div><h3>Your next step</h3><p>Open the source, prepare a request, or ask us.</p></div></li></ol><p class="tools-boundary">A route is not a property record.</p></aside>
    </section>
    <section class="tools-result studio-wrap" id="route-result" hidden aria-labelledby="result-heading"><p class="studio-overline">Your lookup</p><h2 id="result-heading" tabindex="-1"></h2><p id="result-message" role="status"></p><dl id="result-facts"></dl><div class="tools-actions" id="result-actions"></div><ol id="result-steps"></ol><p class="studio-fine">An address match does not establish that a septic system or a record exists. Confirm the property and submission requirements with the responsible office.</p></section>
    <section class="tools-draft" id="draft-request" aria-labelledby="draft-title"><div class="studio-wrap"><div class="tools-draft-heading"><div><p class="studio-overline">02 / Prepare the request</p><h2 id="draft-title">A better first message.</h2></div><p>Put the property details and the document you need in one clear request. Review it, then send through the office’s accepted channel.</p></div>
        <div class="tools-draft-grid"><form id="draft-form">
            <fieldset><legend><span>01</span> The property</legend><label>Property address<input name="address" maxlength="180" autocomplete="street-address" placeholder="Street address, city and ZIP"></label><div class="tools-field-pair"><label>State<select name="state"><option value="">Select state</option>@for(var state : guideStates)<option value="${state.code()}">${state.name()}</option>@endfor</select></label><label>County<input name="county" maxlength="100" autocomplete="off"></label></div>
            <details class="tools-optional"><summary>Add parcel or owner details <span aria-hidden="true">+</span></summary><p>Helpful if you have them. You can draft without these.</p><div class="tools-field-pair"><label>Parcel ID <span>(optional)</span><input name="parcel" maxlength="100"></label><label>Owner or applicant <span>(optional)</span><input name="owner" maxlength="120" autocomplete="off"></label></div></details></fieldset>
            <fieldset><legend><span>02</span> The request</legend><label>Document needed<select name="record"><option>Permit copy</option><option>As-built or system layout</option><option>Final approval</option><option>Repair record</option><option>Inspection letter</option><option>Written no-record response</option></select></label><label>What is this for?<select name="reason"><option>Buying a property</option><option>Repair planning</option><option>An addition or bedroom change</option><option>System replacement</option><option>A lender request</option><option>My property records</option></select></label></fieldset>
            <div class="tools-draft-controls"><a class="studio-text-link" href="#request-preview">Review your message <span aria-hidden="true">↓</span></a><button class="tools-link-button" type="reset">Clear draft</button></div><p class="studio-fine">Draft only. Nothing is sent automatically. Details stay on this page until you copy or download them. Reloading clears them.</p></form>
        <div class="tools-letter" id="request-preview" tabindex="-1"><div class="tools-letter-heading"><span>SepticPath</span><span>REQUEST DRAFT</span></div><label class="studio-overline" for="request-output">Your message</label><textarea id="request-output" readonly rows="17" spellcheck="false"></textarea><div class="tools-actions"><button class="studio-button" id="copy-request" type="button">Copy request <span aria-hidden="true">↗</span></button><button class="tools-link-button" id="download-request" type="button">Download .txt ↓</button></div><p id="draft-status" class="studio-fine" role="status">Confirm the receiving office and any fees before sending.</p><a class="studio-text-link tools-return" href="#draft-form">Edit property details ↑</a></div></div>
        <p class="tools-advanced">Need printable packets, saved progress or follow-up tracking? <a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-records-request-builder/", production)}">Open the full request builder ↗</a></p>
    </div></section>
    <section class="tools-handoff"><img src="/images/studio/research-room-v1.webp" alt="" width="1672" height="941" loading="lazy"><div class="studio-wrap"><p class="studio-overline">We can take it from here</p><h2>Less searching.<br>More clarity.</h2><div class="tools-actions"><a class="studio-button" href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/", production)}">Help with my property ↗</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/offer-prep-septic-file-check/?mode=review", production)}">Already have a file? ↗</a></div></div></section>
</main>
<script src="${AssetPaths.versioned("/studio-tools.js")}" defer></script>
`)
