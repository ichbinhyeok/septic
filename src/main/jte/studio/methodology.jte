@import com.example.septic.web.PageMeta
@import com.example.septic.web.StudioGuideRoutes
@param com.example.septic.web.TrustOperationsPageView operationsPage
@param PageMeta page = null
@param boolean production = false
@template.studio.shell(page = page, production = production, title = "Methodology", heroImage = "/images/studio/research-room-v1.webp", pageClass = "studio-policy", pageStyles = "/studio-policy.css", content = @`
<main id="main"><header class="policy-hero"><img src="/images/studio/research-room-v1.webp" alt="" width="1672" height="941" fetchpriority="high"><div class="studio-wrap"><p class="studio-overline">SepticPath / ${operationsPage.eyebrow()}</p><h1>The source.<br>The standard.</h1><p>${operationsPage.intro()}</p></div></header>
<div class="policy-layout studio-wrap"><aside><p class="studio-overline">${operationsPage.sideLabel()}</p><strong class="policy-count">${operationsPage.sideValue()}</strong><p>${operationsPage.sideBody()}</p><nav aria-label="Methodology sections"><a href="#standards">Operating standards</a><a href="#coverage">Source coverage</a><a href="${com.example.septic.web.StudioGuideRoutes.route("/septic-record-brief-example/", production)}">See our investigations ↗</a></nav></aside><article class="policy-copy"><h2 class="policy-intro">${operationsPage.heading()}</h2>
<div id="standards">@for(var lane : operationsPage.lanes())<section><p class="studio-overline">${lane.label()}</p><h2>${lane.title()}</h2><p>${lane.body()}</p>@if(lane.linkPath() != null && !lane.linkPath().isBlank())<a class="studio-text-link" href="${StudioGuideRoutes.preview(lane.linkPath())}">${lane.linkLabel()} ↗</a>@endif</section>@endfor</div>
<section id="coverage"><h2>${operationsPage.rowSectionTitle()}</h2><p>${operationsPage.rowSectionIntro()}</p><dl class="policy-metrics">@for(var metric : operationsPage.metrics())<div><dt>${metric.label()} / ${metric.value()}</dt><dd>${metric.note()}</dd></div>@endfor</dl>
<div class="policy-table" tabindex="0" role="region" aria-label="State coverage table"><table><thead><tr><th>State</th><th>Workflow pages</th><th>County pages</th><th>Source depth</th><th>Confidence</th><th>Last verified</th></tr></thead><tbody>@for(var row : operationsPage.coverageRows())<tr><th scope="row"><a href="${StudioGuideRoutes.preview(row.statePath())}">${row.stateName()} (${row.stateCode()})</a></th><td>${row.workflowPageCount()}</td><td>${row.countyPageCount()}</td><td>${row.sourceCountLabel()}</td><td>${row.confidenceLabel()}</td><td>${row.lastVerifiedAt()}</td></tr>@endfor</tbody></table></div></section>
<section><h2>${operationsPage.ctaHeading()}</h2><p>${operationsPage.ctaBody()}</p><nav class="policy-related" aria-label="Related standards">@for(var link : operationsPage.nextLinks())<a href="${StudioGuideRoutes.preview(link.path())}">${link.title()} ↗</a>@endfor</nav></section>
<section><h2>What this prevents</h2><ul><li>Publishing a page that only swaps the state or county name.</li><li>Letting an estimate outrank the permit file, county record, or local authority path.</li><li>Scaling pages faster than the source layer can support them.</li></ul></section>
</article></div></main>
`)
