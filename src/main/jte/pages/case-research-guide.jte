@import com.example.septic.web.PageMeta
@import com.example.septic.web.CaseResearchGuides
@import com.example.septic.web.RecordHelpEntry
@import com.example.septic.web.AssetPaths
@param PageMeta page
@param CaseResearchGuides.Guide guide
@template.layouts.app(page = page, designFamily = "editorial", pageStyles = "/record-work-story.css", content = @`
<article class="work-story work-story--intent">
<header class="work-story__header container"><a class="work-story__back" href="/septic-record-brief-example/">Our record research ↗</a><p class="eyebrow">${guide.title()}</p><h1>${guide.headline()}</h1><p class="work-story__lede">${guide.promise()}</p><div class="work-story__hero-actions"><a class="button button--primary" href="${RecordHelpEntry.of(guide.intent()).link(guide.path())}" data-record-help-cta data-track-click="nav" data-track-source-context="case_research_hero" data-track-target-type="lead_form">${guide.action()}</a><a class="text-button" href="#case-answer">See how a real file was reviewed ↓</a></div></header>
<figure class="work-story__visual"><a href="${AssetPaths.versioned("/images/guides/" + guide.image())}" target="_blank" rel="noopener" aria-label="Open illustrative research diagram"><img src="${AssetPaths.versioned("/images/guides/" + guide.image())}" alt="Illustrative research notes for ${guide.title()}. Not an agency record or property plan." width="1536" height="1024" fetchpriority="high"></a><figcaption class="container">Illustrative research notes, not an official document. No customer identifiers or original property geometry are reproduced.</figcaption></figure>
<section class="work-story__findings container" id="case-answer"><p class="eyebrow">From a reviewed customer file</p><h2>${guide.question()}</h2><ol class="work-story__case-trace">@for(var step : guide.caseTrace())<li><h3>${step.title()}</h3><p>${step.text()}</p></li>@endfor</ol><details class="work-story__case-detail"><summary>Read the document details</summary><p>${guide.example()}</p></details><p class="work-story__source">Official record route: <a href="${guide.sourceUrl()}" target="_blank" rel="noopener">${guide.sourceName()} ↗</a>. General route only; the customer's private file is not linked.</p></section>
<section class="work-story__investigation container" id="record-checks"><div class="work-story__sticky"><p class="eyebrow">A practical record check</p><h2>Connect the evidence.<br>Then decide.</h2></div><ol>@for(int i=0; i<guide.steps().size(); i++)<li><span aria-hidden="true">0${i+1}</span><div><h3>${guide.steps().get(i).title()}</h3><p>${guide.steps().get(i).text()}</p></div></li>@endfor</ol></section>
<section class="work-story__handoff"><div class="container"><div><p class="eyebrow">What you receive</p><h2>Your records.<br>Your question, explained.</h2><p>${guide.handoff()}</p><p>We search public sources and contact the relevant records office when needed.</p></div><aside><h3>What still needs local confirmation</h3><p>${guide.boundary()}</p></aside></div></section>
<section class="work-story__next container"><div><h2>Want help with your property?</h2><p>Send the address and your question. Already have the file? Include it so we can connect the pages.</p></div><div><a class="button button--primary" href="${RecordHelpEntry.of(guide.intent()).link(guide.path())}" data-record-help-cta data-track-click="nav" data-track-source-context="case_research_guide" data-track-target-type="lead_form">${guide.action()}</a><small>Research and explanation are free. Any agency fee needs your approval.</small></div></section>
<nav class="work-story__related container" aria-label="Related record research"><h2>Continue your research.</h2><a href="${guide.related()}">${guide.relatedLabel()} →</a>@for(var other : CaseResearchGuides.ALL)@if(!other.slug().equals(guide.slug()))<a href="${other.path()}">${other.title()} ↗</a>@endif@endfor</nav>
</article>
`)
